# terminal-setup transition-aware profile
# Managed profile. Personal settings belong in terminal-setup/user/profile.bash.
case $- in *i*) ;; *) return ;; esac
[[ ${_TERMINAL_SETUP_LEGACY_LOADED:-} == 1 && ! -f "${TERMINAL_SETUP_HOME:-}/current.json" ]] && return
_ts_release="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
# The previous installer downloads this file directly into ~/.config/bash.
# Keep that layout usable until its owner runs the one-time migration.
_ts_legacy_mode=0
if [[ ! -f "$_ts_release/setup.py" ]]; then
    _ts_legacy_mode=1
    export TERMINAL_SETUP_HOME="${TERMINAL_SETUP_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/terminal-setup}"
    if [[ -f "$TERMINAL_SETUP_HOME/load.bash" && -f "$TERMINAL_SETUP_HOME/current.json" ]]; then
        source "$TERMINAL_SETUP_HOME/load.bash"
        return
    fi
    _TERMINAL_SETUP_LEGACY_LOADED=1
fi
export PATH="$_ts_release/.tools:$HOME/.local/bin:$HOME/bin:$PATH"

terminal_setup() {
    if [[ "$_ts_legacy_mode" == 1 ]]; then
        case "${1:-status}" in
            update|install)
                shift
                local installer result
                installer=$(mktemp) || return
                if curl -fsSL --connect-timeout 10 --max-time 60 https://raw.githubusercontent.com/Gouldy-C/terminal-setup/main/install.sh -o "$installer"; then
                    bash "$installer" "$@"
                    result=$?
                else
                    result=$?
                fi
                rm -f -- "$installer"
                return "$result"
                ;;
            launch) return 0 ;;
            *) printf '%s\n' 'Legacy terminal setup is active. Run ts update to migrate; your customizations will be retained.'; return 0 ;;
        esac
    fi
    local python_exe
    python_exe=$(command -v python3) || return
    "$python_exe" "$_ts_release/setup.py" "$@" --root "$TERMINAL_SETUP_HOME"
}
ts() { terminal_setup "$@"; }
update_bashrc() { terminal_setup update; }
reload_profile() {
    unset _TERMINAL_SETUP_LOADED _TERMINAL_SETUP_LEGACY_LOADED
    if [[ -f "$TERMINAL_SETUP_HOME/load.bash" ]]; then
        source "$TERMINAL_SETUP_HOME/load.bash"
    else
        source "$HOME/.bashrc"
    fi
}
ep() {
    if [[ "$_ts_legacy_mode" == 1 ]]; then
        ${EDITOR:-vi} "${XDG_CONFIG_HOME:-$HOME/.config}/bash/profile.bash"
    else
        ${EDITOR:-vi} "$TERMINAL_SETUP_HOME/user/profile.bash"
    fi
}
alias gs='git status'
alias ga='git add .'
gc() { git commit -m "$*"; }
alias gpush='git push'
alias gpull='git pull'
alias gcl='git clone'
gcom() { git add . && git commit -m "$*"; }
lazyg() { gcom "$@" && git push; }
mkcd() { mkdir -p -- "$1" && cd -- "$1"; }
nf() { command touch -- "$@"; }
ff() { find . -iname "*${1:-}*"; }
docs() { cd -- "${XDG_DOCUMENTS_DIR:-$HOME/Documents}"; }
dtop() { cd -- "${XDG_DESKTOP_DIR:-$HOME/Desktop}"; }
get_pub_ip() { curl -fsS --connect-timeout 5 --max-time 10 https://api.ipify.org; printf '\n'; }
alias pubip='get_pub_ip'
sysinfo() { uname -a; uptime; }
if command -v eza >/dev/null 2>&1; then
    alias ls='eza --icons=auto --git'
    alias la='eza -la --icons=auto --git'
    alias ll='eza -la --icons=auto --git'
else
    alias la='ls -la'
    alias ll='ls -la'
fi
if command -v wl-copy >/dev/null 2>&1; then
    cpy() { printf '%s' "$*" | wl-copy; }
    pst() { wl-paste; }
elif command -v xclip >/dev/null 2>&1; then
    cpy() { printf '%s' "$*" | xclip -selection clipboard; }
    pst() { xclip -selection clipboard -o; }
fi
show_help() {
    cat <<'HELP'
Terminal setup
  ts status | ts update | ts rollback
  ep / reload_profile       Edit your overrides / reload this shell
  gs, ga, gc <message>, gpush, gpull, gcl, gcom <message>, lazyg <message>
  ls, la, ll, mkcd <dir>, nf <file>, ff <name>, docs, dtop, z <dir>
  pubip, sysinfo, cpy/pst (requires wl-clipboard or xclip on Linux)
HELP
}
# Defaults first, personal overrides once, then initialization using those settings.
: "${EDITOR:=vi}"
export EDITOR
_ts_legacy="${XDG_CONFIG_HOME:-$HOME/.config}/bash"
[[ -f "$_ts_legacy/profile.bash" ]] && source "$_ts_legacy/profile.bash"
[[ -f "$TERMINAL_SETUP_HOME/user/profile.bash" ]] && source "$TERMINAL_SETUP_HOME/user/profile.bash"
# Recompute a managed default on reload; preserve explicit personal theme choices.
if [[ -n "${_ts_default_omp_config:-}" && "${OMP_CONFIG:-}" == "$_ts_default_omp_config" ]]; then
    unset OMP_CONFIG
fi
if [[ -z "${OMP_CONFIG:-}" ]]; then
    if [[ -f "$TERMINAL_SETUP_HOME/user/my_layout.omp.json" ]]; then
        OMP_CONFIG="$TERMINAL_SETUP_HOME/user/my_layout.omp.json"
    elif [[ -f "$_ts_legacy/my_layout.omp.json" ]]; then
        OMP_CONFIG="$_ts_legacy/my_layout.omp.json"
    else
        OMP_CONFIG="$_ts_release/my_layout.omp.json"
    fi
    _ts_default_omp_config="$OMP_CONFIG"
else
    unset _ts_default_omp_config
fi
if command -v oh-my-posh >/dev/null 2>&1; then
    eval "$(oh-my-posh init bash --config "$OMP_CONFIG")"
fi
if command -v zoxide >/dev/null 2>&1; then
    eval "$(zoxide init bash --cmd z)"
fi
if [[ "$_ts_legacy_mode" == 1 ]]; then
    printf '%s\n' 'Terminal setup: run ts update once to migrate to safe automatic updates.' >&2
fi
if [[ "${debug_Override:-false}" != true && "${TERMINAL_SETUP_AUTO_UPDATE:-1}" != 0 ]]; then
    # launch detaches the worker itself, avoiding shell job notifications.
    terminal_setup launch >/dev/null 2>&1
fi
true
